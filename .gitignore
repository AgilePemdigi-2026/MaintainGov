# Bahan kerja sementara saat membaca dokumen
tmp/

# Dataset mentah lokal; provenance dan fixture tersamar dikelola terpisah
/data/raw/

# Rahasia konfigurasi; contoh tanpa rahasia boleh dibagikan
.env
.env.*
!.env.example
!.env.*.example
*.pem
*.key

# Dependensi dan keluaran yang dapat dibangun ulang
node_modules/
.next/
vendor/
.venv/
__pycache__/
.pytest_cache/

# File log aplikasi lokal
*.log

# Artefak riset privat dan file editor sementara
*.joblib
*.pkl
*.pickle
MaintainGov_artefak_privat*.zip
MaintainGov_hasil_lengkap*.zip
~$*

# Browser test output
/apps/web/test-results/
/apps/web/playwright-report/
