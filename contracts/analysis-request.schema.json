{
  "$defs": {
    "ReviewInput": {
      "properties": {
        "review_id": {
          "exclusiveMinimum": 0,
          "title": "Review Id",
          "type": "integer"
        },
        "text": {
          "maxLength": 10000,
          "minLength": 1,
          "pattern": "\\S",
          "title": "Text",
          "type": "string"
        },
        "rating": {
          "maximum": 5,
          "minimum": 1,
          "title": "Rating",
          "type": "integer"
        }
      },
      "required": [
        "review_id",
        "text",
        "rating"
      ],
      "title": "ReviewInput",
      "type": "object"
    }
  },
  "properties": {
    "schema_version": {
      "const": "1.0",
      "default": "1.0",
      "title": "Schema Version",
      "type": "string"
    },
    "batch_id": {
      "exclusiveMinimum": 0,
      "title": "Batch Id",
      "type": "integer"
    },
    "reviews": {
      "items": {
        "$ref": "#/$defs/ReviewInput"
      },
      "maxItems": 10000,
      "minItems": 1,
      "title": "Reviews",
      "type": "array"
    }
  },
  "required": [
    "batch_id",
    "reviews"
  ],
  "title": "AnalyzeRequest",
  "type": "object",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
