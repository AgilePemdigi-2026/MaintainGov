{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AnalyzeRequest",
  "description": "Kontrak internal Laravel → FastAPI POST /internal/v1/analyze",
  "type": "object",
  "required": ["schema_version", "batch_id", "reviews"],
  "properties": {
    "schema_version": {
      "type": "string",
      "const": "1.0"
    },
    "batch_id": {
      "type": "integer"
    },
    "reviews": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["review_id", "text", "rating"],
        "properties": {
          "review_id": { "type": "integer" },
          "text": { "type": "string", "minLength": 1 },
          "rating": { "type": "integer", "minimum": 1, "maximum": 5 }
        }
      }
    }
  }
}
