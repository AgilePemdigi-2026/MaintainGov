}
class analysis_batch <<entity>> {
 {field} batch_id : bigint PK
 {field} user_id : bigint FK
 {field} request_key : varchar(100)
 {field} source_sha256 : varchar(64)
 {field} status_analisis : Diproses | Selesai | Gagal
