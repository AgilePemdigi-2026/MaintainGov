 {field} analysis_version : nullable varchar(50)
}
class ulasan <<entity>> {
 {field} review_id : bigint PK
 {field} batch_id : bigint FK
 {field} source_review_id : varchar(100)
 {field} teks_ulasan : text
 {field} rating : integer 1..5
 {field} tanggal_ulasan : nullable timestamp
 {field} case_id : nullable bigint FK
 {field} analysis_result : nullable JSON
}
class maintenance_case <<entity>> {
 {field} case_id : bigint PK
 {field} batch_id : nullable bigint FK
 {field} group_key : varchar(100)
 {field} judul_issue : varchar(200)
 {field} kategori : varchar(50)
 {field} modul : varchar(100)
